{
  "name": "qpay-ao-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "QPAY AO — Sistema de pagamentos digitais por QR Code (Next.js + Node.js + Prisma + PostgreSQL)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "next": "^14.2.18",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "prisma": "^5.22.0"
  }
}

